AGENTROUTER_API_KEY=your-agentrouter-api-key
OPENROUTER_API_KEY=sk-or-...your-openrouter-key
NVIDIA_API_KEY=nvapi-...your-nvidia-nim-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...your-google-secret
NEXTAUTH_URL=https://your-domain.vercel.app
AUTH_SECRET=any-random-secret-string

# Payment recipient wallets
NEXT_PUBLIC_PAYMENT_RECIPIENT_EVM=0x0BE165eD3f0B912fE4D41290656c9FFFd2b23EE0
PAYMENT_RECIPIENT_EVM=0x0BE165eD3f0B912fE4D41290656c9FFFd2b23EE0
NEXT_PUBLIC_PAYMENT_RECIPIENT_SOLANA=8bLLgoKTEevg3mCBWQfhQi6BdByuQCwEVjGDJQ226EwG
PAYMENT_RECIPIENT_SOLANA=8bLLgoKTEevg3mCBWQfhQi6BdByuQCwEVjGDJQ226EwG

# Vercel KV (Redis) — auto-filled when you connect KV in Vercel dashboard
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Postgres — auto-filled when you connect Postgres in Vercel dashboard
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Protect /api/db-migrate endpoint (generate a random string)
MIGRATION_SECRET=

# Solana RPC (optional, defaults to public mainnet-beta)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
